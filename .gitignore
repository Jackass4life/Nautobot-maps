__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
htmlcov/
.coverage
*.log

# Local, machine-specific Docker Compose settings (ports, volumes, ...)
docker-compose.override.yml

# The app's own files, mounted at /config (#517): they hold passwords and
# client secrets, so never commit them.
config/*
!config/README.md

# JavaScript dev tools (bun install)
node_modules/

# web/'s build (#463, #609); web/.gitignore has the rest.
web/.nuxt/
web/.output/
