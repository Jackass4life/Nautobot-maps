{
  "name": "web",
  "private": true,
  "description": "The app's pages on Nuxt (#463, #609); built to static files that api/ serves.",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate && bun scripts/no-inline-scripts.mjs",
    "api:generate": "openapi-typescript ./api/openapi.json --output ./api/api.schema.ts",
    "api:generate:from-source": "(cd ../api && uv run python scripts/generate_openapi.py) && bun run api:generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type:check": "nuxt typecheck",
    "test": "vitest run",
    "postinstall": "nuxt prepare",
    "audit": "bun scripts/audit.mjs"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@iconify-json/lucide": "1.2.151",
    "@nuxt/ui": "4.12.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "nuxt": "4.6.4",
    "openapi-fetch": "0.17.0",
    "swagger-ui-dist": "5.34.1",
    "tailwindcss": "4.3.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "eslint": "10.14.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "glob": "13.0.6",
    "typescript": "$typescript"
  },
  "scarfSettings": {
    "enabled": false
  }
}
