NUXT_PUBLIC_API_BASE=http://localhost:8000
# Server-side rendering only, when the API has another address there (e.g. http://api:8000 in compose).
NUXT_API_BASE_SERVER=
# Header sign-in (#582): the API's AUTH_PROXY_SECRET; identity headers are
# forwarded only from requests carrying it. Empty: none are.
NUXT_AUTH_PROXY_SECRET=
