{
  "name": "nautobot-maps-frontend",
  "private": true,
  "description": "The app's pages on Nuxt (#463); built to static files that FastAPI serves.",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate && node scripts/no-inline-scripts.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "api-types": "openapi-typescript openapi.json -o app/api/schema.d.ts",
    "postinstall": "nuxt prepare",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.146",
    "@nuxt/ui": "4.12.0",
    "nuxt": "4.6.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "eslint": "10.13.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
