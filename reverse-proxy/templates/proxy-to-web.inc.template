# The pages (#672): the web image, or the app when one image serves both
# (reverse-proxy/compose.yml), which checks who is signed in for its pages too.
# So the same headers as the API's (proxy-to-api.inc): who is signed in, empty
# where nobody is, so a client can never send its own.  The web image ignores
# them; the API trusts them only from this proxy's address (AUTH_TRUSTED_PROXIES),
# so none counts when the web image forwards a request itself (API_URL).
# $web_upstream: the server's (default.conf), looked up as the request comes in.
proxy_pass $web_upstream;
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-User $auth_id;
proxy_set_header X-Forwarded-Groups $auth_groups;
proxy_set_header X-Auth-Proxy-Secret "${AUTH_PROXY_SECRET}";
proxy_buffer_size 16k;
proxy_buffers 8 16k;
