DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/app
# Or leave the password out of the URL and set it here, as is (no URL encoding).
# DATABASE_PASSWORD=
CORS_ORIGINS=["http://localhost:3000"]
# Sign-in (#582), see README.md
AUTH_MODE=disabled
AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128
AUTH_PROXY_SECRET=
AUTH_VIEWER_GROUPS=
AUTH_OPERATOR_GROUPS=
AUTH_ADMIN_GROUPS=
AUTH_DEFAULT_ROLE=
AUTH_REQUIRE_VIEWER=false
