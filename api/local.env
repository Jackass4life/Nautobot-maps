# Every API setting, for running the API outside a deployment (#760): the tests
# (tests/conftest.py loads it), `python run.py` (cp local.env .env, then change what
# you need), CI, and the demo and development stacks (their compose files read it
# first, then their own file). A deployment's .env starts from ../.env.example instead.
#
# The code has no defaults: every name here must be in the API's environment or .env,
# or it won't start. These are the values the code used until #760. Each one is
# described in docs/configuration.md. tests/test_settings.py keeps this file and the
# Settings fields the same.

DATABASE_PASSWORD=
CORS_ORIGINS=
# Relative to api/: where `bun run generate` puts the pages.
WEB_BUILD_DIR=../web/.output/public
SQL_ECHO=false
FLASK_DEBUG=false
FLASK_RUN_PORT=
LOG_LEVEL=INFO
LOG_FORMAT=text
NAUTOBOT_URL=
NAUTOBOT_TOKEN=
NAUTOBOT_API_VERSION=
NAUTOBOT_VERIFY_SSL=true
EXTRA_CA_PEM=
CACHE_TTL=300
CACHE_TYPE=SimpleCache
CACHE_REDIS_URL=
# Empty: CACHE_TTL.
INVENTORY_SYNC_INTERVAL_SECONDS=
LIBRENMS_SYNC_INTERVAL_SECONDS=
BACKGROUND_SYNC_ENABLED=true
LIBRENMS_URL=
LIBRENMS_API_TOKEN=
LIBRENMS_VERIFY_SSL=true
WIRELESS_CONTROLLERS=
WIRELESS_SYNC_INTERVAL_SECONDS=300
ALERT_HISTORY_RETENTION_DAYS=730
METRICS_ENABLED=true
NOTIFY_MIN_LEVEL=critical
NOTIFY_TENANTS=
NOTIFY_BOARD_URL=
NOTIFY_SUMMARY_THRESHOLD=5
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
NOTIFY_TEAMS_WEBHOOK_URL=
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
MCP_ENABLED=false
MCP_ALLOWED_ORIGINS=
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
MAP_DEFAULT_VIEW=
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT='nautobot-maps (+https://github.com/Jackass4life/Nautobot-maps)'
NAUTOBOT_MAPS_DATABASE_URL=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_SECONDS=60
AUTH_MODE=disabled
AUTH_HEADER_USER=X-Forwarded-User
AUTH_HEADER_GROUPS=X-Forwarded-Groups
AUTH_DEFAULT_ROLE=
AUTH_VIEWER_GROUPS=
AUTH_OPERATOR_GROUPS=
AUTH_ADMIN_GROUPS=
AUTH_NOC_GROUPS=
AUTH_DOV_GROUPS=
AUTH_CUSTOMER_GROUPS=
AUTH_REQUIRE_VIEWER=false
AUTH_GROUP_ROLES=true
AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128
AUTH_PROXY_SECRET=
AUTH_SIGN_OUT_URL=
AD_HOST=
JWT_SIGNING_SECRET=
JWT_LIFETIME_SECONDS=28800
JWT_ISSUER=nautobot-maps
JWT_AUDIENCE=nautobot-maps
ALLOW_UNAUTHENTICATED_WRITES=false
CRITICAL_ROLE_KEYWORDS=
CRITICALITY_RULES=
ALERT_BOARD_EXCLUDED_LOCATION_TYPES=graveyard,warehouse
ALERT_BOARD_EXCLUDED_LOCATION_STATUSES=
ALERT_BOARD_EXCLUDED_LOCATION_TAGS=
ALERT_BOARD_EXCLUDED_LOCATION_NAMES=
ALERT_BOARD_EXCLUDED_DEVICE_STATUSES=
ALERT_DELAY_SECONDS=0
FLAP_CHANGES=4
ALERTMANAGER_DEVICE_LABELS=instance,hostname,host,device
ALERTMANAGER_ALERTNAMES=
WEBHOOK_ALERT_TTL_HOURS=24
ALERT_MEDIUM_PERCENT=25
ALERT_CRITICAL_PERCENT=100
SITE_TIER_FIELD=
SITE_TIERS=gold,silver,bronze
TENANT_SCOPE_FIELD=
STATUS_PAGE_TENANT_DEVICES=false
COUNTRY_LOCATION_TYPE=Country
DEVICE_CRITICALITY_FIELD=
TIER_DEVICE_LEVEL=
WIRELESS_AP_LEVEL=low
NOTIFY_MIN_LEVEL_BY_TIER=
CASE_URL_TEMPLATE=
COMPRESS_RESPONSES=true
AVAILABILITY_BASIS=any_down
AVAILABILITY_TARGET_PCT=99.9
ALERT_BOARD_SITE_LOCATION_TYPE=
SITE_TENANT_RELATIONSHIPS=
ACCESS_POINT_ROLES='access point'
