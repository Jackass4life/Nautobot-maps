# Nautobot API configuration
NAUTOBOT_URL=https://your-nautobot-instance.example.com
NAUTOBOT_TOKEN=your_api_token_here

# Optional: Pin a specific Nautobot REST API version (e.g. "2.0" or "3.0").
# When left empty the server's default version is used, which works with any Nautobot release.
# NAUTOBOT_API_VERSION=

# SSL verification for Nautobot API requests.
# "true"  – verify SSL certificates (default)
# "false" – skip verification (e.g. self-signed certificates)
# Or provide a path to a custom CA bundle file.
NAUTOBOT_VERIFY_SSL=true

# Flask configuration
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=false
# Optional: Port for the Flask development server (default: 5000)
# On macOS, port 5000 may conflict with AirPlay Receiver – try 8080 or another free port.
FLASK_RUN_PORT=5000

# Optional: Cache duration in seconds for Nautobot API responses (default: 300)
CACHE_TTL=300

# Optional: Cache backend used by Flask-Caching (default: SimpleCache).
# Set to "RedisCache" in production with multiple Gunicorn workers so all
# workers share one cache and don't each hit the Nautobot API independently.
# CACHE_TYPE=RedisCache
# CACHE_REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Configurable criticality settings
# ---------------------------------------------------------------------------

# Optional: Comma-separated list of device role keywords that identify
# critical infrastructure.  Overrides the built-in defaults
# (core, spine, distribution, router, gateway) for every location type that
# has no specific entry in CRITICALITY_RULES_FILE.
# Example: CRITICAL_ROLE_KEYWORDS=core,spine,distribution,router,gateway,firewall
# CRITICAL_ROLE_KEYWORDS=

# Optional: Path to a JSON file with per-location-type criticality rules.
# See criticality_rules.json for an example.
# Example: CRITICALITY_RULES_FILE=criticality_rules.json
# CRITICALITY_RULES_FILE=

# ---------------------------------------------------------------------------
# SQLite persistence (optional)
# ---------------------------------------------------------------------------

# Optional: Path to the SQLite database used to store per-device criticality
# overrides and LibreNMS ↔ Nautobot device ID mappings.
# Leave empty to disable persistence (overrides and mappings are not stored).
# Example: NAUTOBOT_MAPS_DB=nautobot_maps.db
# NAUTOBOT_MAPS_DB=

# ---------------------------------------------------------------------------
# LibreNMS optional integration
# ---------------------------------------------------------------------------

# Optional: LibreNMS base URL and API token.  When both are set, LibreNMS
# live device status (ICMP/SNMP reachability) is merged into the Nautobot
# device status before computing the NOC alert level.  A device that is
# "Active" in Nautobot but reported as down by LibreNMS will be treated as
# offline for alerting purposes.
# LIBRENMS_URL=https://librenms.example.com
# LIBRENMS_API_TOKEN=your_librenms_api_token_here
