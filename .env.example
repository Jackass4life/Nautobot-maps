# Nautobot API configuration
NAUTOBOT_URL=https://your-nautobot-instance.example.com
NAUTOBOT_TOKEN=your_api_token_here

# Optional: Pin a specific Nautobot REST API version (e.g. "2.0" or "3.0").
# When left empty the server's default version is used, which works with any Nautobot release.
# NAUTOBOT_API_VERSION=

# SSL verification for Nautobot API requests.
# "true"  – verify SSL certificates (default)
# "false" – skip verification (e.g. self-signed certificates)
# Or provide a path to a custom CA bundle file.
NAUTOBOT_VERIFY_SSL=true

# Flask configuration
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=false
# Optional: Port for the Flask development server (default: 5000)
# On macOS, port 5000 may conflict with AirPlay Receiver – try 8080 or another free port.
FLASK_RUN_PORT=5000

# Optional: Cache duration in seconds for Nautobot API responses (default: 300)
CACHE_TTL=300

# Optional: Cache backend used by Flask-Caching (default: SimpleCache).
# Set to "RedisCache" in production with multiple Gunicorn workers so all
# workers share one cache and don't each hit the Nautobot API independently.
# CACHE_TYPE=RedisCache
# CACHE_REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Configurable criticality settings
# ---------------------------------------------------------------------------

# Optional: Comma-separated list of device role keywords that identify
# critical infrastructure.  Overrides the built-in defaults
# (core, spine, distribution, router, gateway) for every location type that
# has no specific entry in CRITICALITY_RULES_FILE.
# Example: CRITICAL_ROLE_KEYWORDS=core,spine,distribution,router,gateway,firewall
# CRITICAL_ROLE_KEYWORDS=

# Optional: Path to a JSON file with per-location-type criticality rules.
# See criticality_rules.json for an example.
# Example: CRITICALITY_RULES_FILE=criticality_rules.json
# CRITICALITY_RULES_FILE=

# ---------------------------------------------------------------------------
# Persistence (PostgreSQL preferred, SQLite fallback)
# ---------------------------------------------------------------------------

# Preferred: PostgreSQL URL for lifecycle/history/case tracking.
# Example:
# NAUTOBOT_MAPS_DATABASE_URL=postgresql://nautobot_maps@postgres:5432/nautobot_maps
# NAUTOBOT_MAPS_DATABASE_URL=

# Optional: Path to the SQLite database used to store per-device criticality
# overrides, LibreNMS mappings, and alert lifecycle history when PostgreSQL is
# not configured.
# Leave empty to disable persistence (overrides and mappings are not stored).
# Example (local run): NAUTOBOT_MAPS_DB=nautobot_maps.db
# Example (Docker, runs as non-root): NAUTOBOT_MAPS_DB=/app/data/nautobot_maps.db
#   and mount a volume at /app/data so the file survives container rebuilds.
# NAUTOBOT_MAPS_DB=

# Optional: minimum seconds between inventory syncs. An open alert board
# starts a sync once it is due and counts down to it. Defaults to CACHE_TTL.
# INVENTORY_SYNC_INTERVAL_SECONDS=300
# LIBRENMS_SYNC_INTERVAL_SECONDS=300

# Optional: hide non-operational locations from the alert board by Nautobot
# attributes. Matching is case-insensitive and accepts commas or semicolons.
# ALERT_BOARD_EXCLUDED_LOCATION_TYPES=graveyard,warehouse
# ALERT_BOARD_EXCLUDED_LOCATION_STATUSES=
# ALERT_BOARD_EXCLUDED_LOCATION_TAGS=
# ALERT_BOARD_EXCLUDED_LOCATION_NAMES=

# ---------------------------------------------------------------------------
# Optional authentication / RBAC
# ---------------------------------------------------------------------------

# Leave AUTH_MODE=disabled to keep the map and alerts public and preserve the
# current behavior of all routes.
# Set AUTH_MODE=header to protect administrative API routes using identity
# headers injected by a trusted reverse proxy / SSO gateway.
# Supported values: disabled, header
# AUTH_MODE=disabled

# Header mode only: header names containing the authenticated username and
# comma-separated group list supplied by your reverse proxy.
# AUTH_HEADER_USER=X-Forwarded-User
# AUTH_HEADER_GROUPS=X-Forwarded-Groups

# Optional fallback role for authenticated users whose groups do not match any
# of the role mappings below. Supported values: viewer, operator, admin.
# Leave empty to deny admin API access unless a group mapping matches.
# AUTH_DEFAULT_ROLE=

# Header mode only: map identity-provider groups to app roles.
# Group names are matched case-insensitively.
# AUTH_VIEWER_GROUPS=nautobot-viewers
# AUTH_OPERATOR_GROUPS=nautobot-operators
# AUTH_ADMIN_GROUPS=nautobot-admins

# ---------------------------------------------------------------------------
# LibreNMS optional integration
# ---------------------------------------------------------------------------

# Optional: LibreNMS base URL and API token. When both are set, LibreNMS is
# used as a collector/status source only. Its live device status
# (ICMP/SNMP reachability) is merged into the Nautobot device status before
# this application computes site alert state for the map and alert board.
# A device that is "Active" in Nautobot but reported as down by LibreNMS will
# be treated as offline for alerting purposes.
# LIBRENMS_URL=https://librenms.example.com
# LIBRENMS_API_TOKEN=your_librenms_api_token_here
# LIBRENMS_VERIFY_SSL=true
