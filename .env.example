# Nautobot Maps: every setting, in one file (#739).
#
#   cp .env.example .env && chmod 600 .env
#
# docker compose gives each container (postgres, api, web, and with the bundled
# proxy nginx and oauth2-proxy) this whole file: nothing is set in the compose files,
# and nothing is read from other files. It holds passwords (the database, LDAP's bind
# account, the wireless controllers'), so only you may read it: chmod 600. It never
# goes into an image (each .dockerignore leaves it out).
#
# Values are as written: no ${VAR} references. Single quotes around JSON
# ('{"...": ...}') and around a value with a $ in it (a password). Compose itself
# reads this file too, for the ports, the networks, COMPOSE_FILE and PUBLIC_HOSTNAME.
#
# Running the API outside Docker (cd api && uv run python run.py)? Copy this to
# api/.env and change the hosts: localhost, not postgres or redis.

# ---------------------------------------------------------------------------
# The compose stack (docker-compose.yml)
# ---------------------------------------------------------------------------

# The bundled PostgreSQL: set your own password before the first
# `docker compose up`; it is fixed when the data volume is created. The URL is the
# app's way in: the same user, password and database, at the postgres service.
POSTGRES_DB=nautobot_maps
POSTGRES_USER=nautobot_maps
POSTGRES_PASSWORD=nautobot_maps
NAUTOBOT_MAPS_DATABASE_URL=postgresql://nautobot_maps:nautobot_maps@postgres:5432/nautobot_maps
# Or leave the password out of the URL and set it here, as is (no URL encoding: a
# password with @, : or % needs no escaping).
# DATABASE_PASSWORD=

# The bundled Redis: one cache for every Gunicorn worker (and the MCP rate limit).
# Without these (outside compose) each process has its own (SimpleCache).
CACHE_TYPE=RedisCache
CACHE_REDIS_URL=redis://redis:6379/0

# The web container passes the API's paths (/api/, /healthz, /metrics, ...) here.
API_URL=http://api:5000

# ---------------------------------------------------------------------------
# Nautobot
# ---------------------------------------------------------------------------

NAUTOBOT_URL=https://your-nautobot-instance.example.com
# Read-only is enough: the app never writes to Nautobot.
NAUTOBOT_TOKEN=your_api_token_here

# Optional: Pin a specific Nautobot REST API version (e.g. "2.0" or "3.0").
# When left empty the server's default version is used, which works with any Nautobot release.
# NAUTOBOT_API_VERSION=

# SSL verification for Nautobot API requests.
# "true"  – verify SSL certificates (default)
# "false" – skip verification (e.g. self-signed certificates)
# Signed by a company CA? Keep true and put the CA in EXTRA_CA_PEM below.
NAUTOBOT_VERIFY_SSL=true

# Optional: your company CA (#739), as PEM text: trusted, with the public CAs, by the
# connections to Nautobot, LibreNMS and the wireless controllers, and alone by
# LDAP's (the domain controller). On one line with \n for each line break, or
# base64 of the file (base64 -w0 company-ca.pem). Several certificates: one after
# the other. A certificate is public: no secret here.
# EXTRA_CA_PEM=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----

# Optional: log level (DEBUG, INFO, WARNING, ERROR) and format (text or json).
# LOG_LEVEL=INFO
# LOG_FORMAT=text

FLASK_DEBUG=false
# Optional: the development server (cd api && uv run python run.py): FLASK_DEBUG=true reloads on
# changes, FLASK_RUN_PORT is its port (default: 5000). The names are kept from Flask.
# On macOS, port 5000 may conflict with AirPlay Receiver – try 8080 or another free port.
FLASK_RUN_PORT=5000

# Optional: Cache duration in seconds for Nautobot API responses (default: 300)
CACHE_TTL=300

# Optional: Gunicorn (the Docker image's server). Defaults: 4 workers, a 120 s
# timeout (the minimum), and bind 0.0.0.0:5000 (127.0.0.1:5000 with AUTH_MODE=header).
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=120
# GUNICORN_BIND=0.0.0.0:5000

# ---------------------------------------------------------------------------
# Configurable criticality settings
# ---------------------------------------------------------------------------

# Optional: Comma-separated list of device role keywords that identify
# critical infrastructure.  Overrides the built-in defaults
# (core, spine, distribution, router, gateway) for every location type that
# has no specific entry in CRITICALITY_RULES.
# Example: CRITICAL_ROLE_KEYWORDS=core,spine,distribution,router,gateway,firewall
# CRITICAL_ROLE_KEYWORDS=

# Optional: critical role keywords per location type (#739: JSON, on one line, in
# single quotes). A location type not listed: "default", else the keywords above.
# CRITICALITY_RULES='{"default": ["core", "spine", "distribution", "router", "gateway"], "datacenter": ["core", "spine", "firewall", "router", "gateway", "border"], "pop": ["core", "router", "gateway"], "office": ["core", "router"], "branch": ["router", "gateway"]}'

# ---------------------------------------------------------------------------
# Persistence (PostgreSQL)
# ---------------------------------------------------------------------------

# NAUTOBOT_MAPS_DATABASE_URL (top) is PostgreSQL for the inventory snapshot,
# criticality overrides, LibreNMS mappings, alert history and cases. Your own
# PostgreSQL instead of the bundled one: its URL there.
# (SQLite and NAUTOBOT_MAPS_DB are no longer supported.)
# Optional: PostgreSQL connect / statement timeouts in seconds (defaults 5 / 60).
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_SECONDS=60

# Optional: minimum seconds between inventory syncs. A background scheduler
# runs them once due (and records alert history) even with no page open; an
# open alert board counts down to the next one. Defaults to CACHE_TTL.
# Set BACKGROUND_SYNC_ENABLED=false to only sync when pages are loaded.
# BACKGROUND_SYNC_ENABLED=true
# INVENTORY_SYNC_INTERVAL_SECONDS=300
# LIBRENMS_SYNC_INTERVAL_SECONDS=300

# Optional: other monitoring tools post device-down alerts to
# /api/v1/alertmanager or /api/v1/device-status (docs/sources.md).
# ALERTMANAGER_DEVICE_LABELS=instance,hostname,host,device
# ALERTMANAGER_ALERTNAMES=                # empty: every alert Alertmanager sends
# WEBHOOK_ALERT_TTL_HOURS=24              # a firing alert not repeated for this long stops counting

# Optional: hide non-operational locations from the alert board by Nautobot
# attributes. Matching is case-insensitive and accepts commas or semicolons.
# In the status settings, "null" matches a missing or empty status.
# ALERT_BOARD_EXCLUDED_LOCATION_TYPES=graveyard,warehouse
# ALERT_BOARD_EXCLUDED_LOCATION_STATUSES=null,decommissioning,planned
# ALERT_BOARD_EXCLUDED_LOCATION_TAGS=
# ALERT_BOARD_EXCLUDED_LOCATION_NAMES=

# Optional: ignore devices with these Nautobot statuses on the alert board.
# They are not counted as monitored or as down, and are not listed. Without
# this, a Decommissioning device counts as down and can make a site Critical.
# ALERT_BOARD_EXCLUDED_DEVICE_STATUSES=null,decommissioning,planned

# Optional: a device must be down this many seconds before it alarms. Shorter
# blips are not shown, counted, recorded or notified. 0 (default): at once.
# LibreNMS has its own alert delay; set one or the other.
# ALERT_DELAY_SECONDS=120

# Optional: a device that goes up or down this many times within 30 minutes is
# flapping: it stays one incident with a FLAPPING label, and its site's level
# doesn't bounce, until it has been steady for 30 minutes. Default 4; 0: off.
# FLAP_CHANGES=4

# Optional: what the availability report counts as downtime: "any_down" (any
# monitored device of the site down; default) or "critical" (the site at Critical).
# AVAILABILITY_BASIS=any_down

# Optional: the availability target (the SLA) in percent, above 0 and below 100.
# A site or tenant below it is shown in red on Availability. Default 99.9.
# AVAILABILITY_TARGET_PCT=99.9

# Optional: make every case number a link to its ticket in your ITSM system.
# {case} is replaced by the (URL-encoded) case number.
# CASE_URL_TEMPLATE=https://itsm.example.com/ticket/{case}

# Optional: severity thresholds. More than ALERT_MEDIUM_PERCENT of a site's
# monitored devices down is Medium (default 25); ALERT_CRITICAL_PERCENT or more
# is Critical (default 100: only when all are down).
# ALERT_MEDIUM_PERCENT=25
# ALERT_CRITICAL_PERCENT=100

# Optional: site importance from a Nautobot custom field on the location, its
# values most important first, and a lower notification level for some tiers.
# SITE_TIER_FIELD=tier

# Optional: role-based device scope per tenant's status page. The Location
# custom field is a JSON object, e.g. {"Acme Corp":["Access Switch","Firewall"]}.
# TENANT_SCOPE_FIELD=tenant_scope

# Optional: on a tenant's status page, list by name the devices whose Tenant in
# Nautobot is that customer, up or down (#555). Off: counts only.
# STATUS_PAGE_TENANT_DEVICES=false

# Optional: the Nautobot location type whose locations are countries (default
# Country): a site's country is the one above it (#386).
# COUNTRY_LOCATION_TYPE=Country
# SITE_TIERS=gold,silver,bronze
# NOTIFY_MIN_LEVEL_BY_TIER=gold:low,silver:medium

# Optional: what a down device makes its site (#377). A Nautobot custom field
# on the device (critical, medium or low), and a default per site tier. A
# device's own field wins; without either, the share of devices down decides.
# DEVICE_CRITICALITY_FIELD=criticality
# TIER_DEVICE_LEVEL=gold:critical,silver:medium

# Optional: show one alert-board row per location of this type (e.g. Site) and
# count the devices of its child locations (buildings, floors, ...) towards it.
# Levels above it (Region, Country) get no rows. Empty: one row per location.
# ALERT_BOARD_SITE_LOCATION_TYPE=Site

# Optional: a site's tenants are its Nautobot tenant plus the tenants linked to
# it by a Location <-> Tenant Relationship. Name the relationships (key or
# label) to use only those. Empty: every Location <-> Tenant relationship.
# SITE_TENANT_RELATIONSHIPS=site-customers

# Optional: the Nautobot device roles that are access points (comma-separated,
# capitals don't matter). Availability shows each site's "12 network · 40 APs".
# ACCESS_POINT_ROLES=Access Point

# ---------------------------------------------------------------------------
# Optional authentication / RBAC
# ---------------------------------------------------------------------------

# Leave AUTH_MODE=disabled to keep the map and alerts public and preserve the
# current behavior of all routes.
# Set AUTH_MODE=header to protect administrative API routes using identity
# headers injected by a trusted reverse proxy / SSO gateway.
# Supported values: disabled, header
# AUTH_MODE=disabled

# Header mode only: header names containing the authenticated username and
# comma-separated group list supplied by your reverse proxy.
# AUTH_HEADER_USER=X-Forwarded-User
# AUTH_HEADER_GROUPS=X-Forwarded-Groups

# Optional fallback role for authenticated users whose groups do not match any
# of the role mappings below. Supported values: viewer, operator, admin.
# Leave empty to deny admin API access unless a group mapping matches.
# AUTH_DEFAULT_ROLE=

# Header mode only: map identity-provider groups to app roles.
# Group names are matched case-insensitively.
# AUTH_VIEWER_GROUPS=nautobot-viewers
# AUTH_OPERATOR_GROUPS=nautobot-operators
# AUTH_ADMIN_GROUPS=nautobot-admins
# NOC (the wall view, the board, acknowledgements and cases) and customer
# (availability and each customer's status, read only), #691:
# AUTH_NOC_GROUPS=noc-duty
# AUTH_DOV_GROUPS: AUTH_NOC_GROUPS's name until 0.5.1, still read when that is empty.
# AUTH_DOV_GROUPS=
# AUTH_CUSTOMER_GROUPS=account-managers
# One role per user, the first of admin, operator, noc, customer, viewer; see
# `docker compose exec api python -m app roles`.
# Header mode: require at least the viewer role for every page and API
# (except /healthz). Default: reads are public.
# AUTH_REQUIRE_VIEWER=false
# Someone signed in without an identity (python -m app identity create …): the role
# their groups give (true), or no access (false, once everyone has one).
# AUTH_GROUP_ROLES=true
# Sign-in with AD on the app's own page, /auth (#717): off until LDAP_URL is set.
# See docs/authentication.md#sign-in-with-ad.
# LDAP_URL=ldaps://dc1.example.local
# LDAP_BASE_DN=DC=example,DC=local
# LDAP_BIND_DN=svc-maps@example.local
# LDAP_BIND_PASSWORD=
# The attribute a user name is matched against (default sAMAccountName).
# LDAP_USER_ATTRIBUTE=sAMAccountName
# The domain controller's CA: EXTRA_CA_PEM (above); without it, the public CAs.
# ldap:// (no TLS) only for tests: LDAP_ALLOW_PLAINTEXT=true.
# LDAP_ALLOW_PLAINTEXT=false
# LDAP_TIMEOUT_SECONDS=10
# JWT_SIGNING_SECRET=                  # openssl rand -base64 48
# JWT_LIFETIME_SECONDS=28800
# JWT_ISSUER=nautobot-maps
# JWT_AUDIENCE=nautobot-maps
# Header mode: the reverse proxy's IPs/CIDRs; identity headers from anywhere
# else are ignored. Default: localhost only (127.0.0.1/32,::1/128).
# AUTH_TRUSTED_PROXIES=172.30.0.0/24
# Header mode: when set, the proxy must also send this in X-Auth-Proxy-Secret.
# AUTH_PROXY_SECRET=
# Header mode: where the top bar's Sign out goes (#546): your proxy's sign-out
# address. Empty: no Sign out. The bundled proxy sets /oauth2/sign_out.
# AUTH_SIGN_OUT_URL=
# AUTH_MODE=disabled only: allow changing criticality overrides without
# authentication. Off by default (they return 403).
# ALLOW_UNAUTHENTICATED_WRITES=false

# ---------------------------------------------------------------------------
# HTTPS and sign-in: the bundled nginx + oauth2-proxy (#423, optional)
# ---------------------------------------------------------------------------
# Certificate files: reverse-proxy/certs/fullchain.pem and privkey.pem.
# Set the groups above (AUTH_VIEWER_GROUPS, ...) to your provider's group names
# or IDs. Setup and provider examples: docs/authentication.md.
# COMPOSE_FILE=docker-compose.yml:reverse-proxy/compose.yml
# Or HTTPS with the app's own sign-in (AD on /auth, #723), no oauth2-proxy: set
# "Sign-in with AD" above, PUBLIC_HOSTNAME and AUTH_PROXY_SECRET; no OIDC_* or
# OAUTH2_PROXY_*, and no AUTH_SIGN_OUT_URL.
# COMPOSE_FILE=docker-compose.yml:reverse-proxy/compose.app-sign-in.yml
# PUBLIC_HOSTNAME=maps.example.com
#
# With either, the API behind the proxy needs these too (#739: the compose files
# set nothing). AUTH_TRUSTED_PROXIES is PROXY_IP (below) with /32. The API refuses
# to start with AUTH_PROXY_SECRET but without AUTH_MODE=header.
# AUTH_MODE=header
# AUTH_REQUIRE_VIEWER=true
# AUTH_TRUSTED_PROXIES=172.30.0.10/32
# openssl rand -hex 32
# AUTH_PROXY_SECRET=
# oauth2-proxy only: the top bar's Sign out.
# AUTH_SIGN_OUT_URL=/oauth2/sign_out
#
# oauth2-proxy: your identity provider. Its secrets have oauth2-proxy's own names.
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OAUTH2_PROXY_CLIENT_SECRET=
# python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
# OAUTH2_PROXY_COOKIE_SECRET=
# Optional: the claims (Entra ID: OIDC_EMAIL_CLAIM=preferred_username), the
# scope, the ports, and the address nginx has on its own network.
# OIDC_GROUPS_CLAIM=groups
# OIDC_EMAIL_CLAIM=email
# OIDC_SCOPE=openid email profile
# Optional: a PEM file with the CA(s) that signed your identity provider's
# certificate, when that is a company CA (self-managed GitLab, Keycloak, ADFS):
# OIDC_CA_FILE is the file on this host, mounted into oauth2-proxy, and
# OAUTH2_PROXY_PROVIDER_CA_FILES tells oauth2-proxy to read it (set both). Trusted
# together with the public CAs; must be readable by all (chmod 644). oauth2-proxy
# reads only a file, so this is the one file left (next to the TLS certificate).
# OIDC_CA_FILE=./reverse-proxy/certs/company-ca.pem
# OAUTH2_PROXY_PROVIDER_CA_FILES=/etc/oauth2-proxy/provider-ca.pem
# Optional: your identity provider's logout address (#546). Sign out ends the
# app's session, then goes here to end the provider's too; without it the
# provider signs you straight back in. Examples: docs/authentication.md.
# OIDC_LOGOUT_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/logout?post_logout_redirect_uri=https://maps.example.com/
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443
# PROXY_SUBNET=172.30.0.0/24
# PROXY_IP=172.30.0.10

# ---------------------------------------------------------------------------
# LibreNMS optional integration
# ---------------------------------------------------------------------------

# Optional: LibreNMS base URL and API token. When both are set, LibreNMS is
# used as a collector/status source only. Its live device status
# (ICMP/SNMP reachability) is merged into the Nautobot device status before
# this application computes site alert state for the map and alert board.
# A device that is "Active" in Nautobot but reported as down by LibreNMS will
# be treated as offline for alerting purposes.
# LIBRENMS_URL=https://librenms.example.com
# LIBRENMS_API_TOKEN=your_librenms_api_token_here
# true or false; a company CA goes in EXTRA_CA_PEM.
# LIBRENMS_VERIFY_SSL=true

# Optional: access point status from wireless controllers (#508): any number
# of Cisco Catalyst Center and HPE Aruba Networking New Central instances, with
# their read-only accounts and API clients, as JSON on one line in single quotes
# (#739; every key: docs/sources.md). A mistake stops the app at startup, naming
# the instance, never the password. An AP a controller lists is monitored without a
# primary IP, shown with the controller's address (never written to Nautobot), and
# down when the controller says so (#521).
# WIRELESS_CONTROLLERS='{"catalyst_center": [{"name": "dk", "url": "https://dnac-dk.example.com", "username": "maps-ro", "password": "secret"}], "aruba_central": [{"name": "eu", "region": "de1", "client_id": "maps-ro", "client_secret": "secret"}]}'
# How often each controller is read (seconds; at least 60).
# WIRELESS_SYNC_INTERVAL_SECONDS=300
# A site with only access points down: this level (critical, medium or low),
# under the board's Wireless chip, not an alarm, never notified. An AP with a
# level set in Nautobot (DEVICE_CRITICALITY_FIELD) is an alarm at that level.
# WIRELESS_AP_LEVEL=low

# Optional: delete resolved alert history (and site severity changes) older than
# this many days, once a day. Default (unset or empty) 730; 0 keeps everything.
# ALERT_HISTORY_RETENTION_DAYS=730

# Optional: Prometheus metrics at /metrics (default true).
# METRICS_ENABLED=true

# Optional: gzip text answers over 1 KB (default true). false where the proxy in
# front compresses instead.
# COMPRESS_RESPONSES=true

# Optional: other sites' pages that may call the API from the browser
# (comma-separated); the app's own pages need nothing.
# CORS_ORIGINS=https://portal.example.com

# Optional: MCP server at /mcp so AI assistants (Claude, ...) can read the alert
# board and add cases, with the same sign-in and roles as the web UI (default false).
# MCP_ENABLED=true
# Browser origins allowed to call /mcp (comma-separated scheme://host[:port]).
# MCP clients send no Origin; leave empty unless a web-based client needs it.
# MCP_ALLOWED_ORIGINS=

# Optional: notifications when a site's alert level changes (docs/notifications.md).
# A site reaching NOTIFY_MIN_LEVEL (low, medium, critical; default critical), and
# dropping back below it. Each channel is on when its setting is filled in.
# NOTIFY_MIN_LEVEL=critical
# NOTIFY_TENANTS=                      # only sites with these tenants (comma-separated)
# NOTIFY_BOARD_URL=https://nautobot-maps.example.com   # for the link in messages
# NOTIFY_SUMMARY_THRESHOLD=5           # more changes at once: one summary message
# NOTIFY_WEBHOOK_URL=https://example.com/hook          # JSON POST
# NOTIFY_WEBHOOK_SECRET=               # signs the body: X-Nautobot-Maps-Signature
# NOTIFY_TEAMS_WEBHOOK_URL=            # Teams Workflows "post to a channel" webhook URL
# NOTIFY_EMAIL_TO=noc@example.com
# SMTP_HOST=smtp.example.com          # also mails customers whose status token has addresses (#707)
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=nautobot-maps@example.com
# SMTP_STARTTLS=true

# Optional: map tiles and address search. Default: the public OpenStreetMap
# services. Point them at internal ones on closed networks, or turn address
# search off (then only "lat,lon" searches work).
# MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# The map's first view, lat,lon,zoom (#362); empty: fit it to the sites.
# MAP_DEFAULT_VIEW=55.7,12.6,6
# GEOCODER_ENABLED=true
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=nautobot-maps (+https://github.com/Jackass4life/Nautobot-maps)

# ---------------------------------------------------------------------------
# The pages (web)
# ---------------------------------------------------------------------------
# The API is the pages' own origin (#594). Another one, at build time only
# (bun run generate): NUXT_PUBLIC_API_BASE.
# NUXT_PUBLIC_API_BASE=
