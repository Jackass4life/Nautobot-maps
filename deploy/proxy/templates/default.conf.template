# nginx in front of Nautobot Maps (#423): HTTPS, and company sign-in through
# oauth2-proxy.  ${PUBLIC_HOSTNAME}, ${AUTH_PROXY_SECRET}, ${OIDC_ISSUER_URL} and
# ${OIDC_LOGOUT_URL} are filled in when the container starts; everything else
# with a $ is nginx's own.

# An API token (LibreNMS, Alertmanager, scripts, MCP) skips the login: the app
# checks it.  Matched on the header, so no path is open without one.
map $http_authorization $api_token {
    "~*^Bearer\s+nmt_" 1;
    default 0;
}

# Where Sign out ends up (#546): the identity provider's logout, so its
# session ends too; without one (GitLab has none), a page that says so, not
# the app, where the identity provider would sign the user straight back in.
map "${OIDC_LOGOUT_URL}" $sign_out_next {
    "" /signed-out;
    default "${OIDC_LOGOUT_URL}";
}

# The name the app shows: the username, else the e-mail address.
map $auth_user $auth_id {
    "" $auth_email;
    default $auth_user;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${PUBLIC_HOSTNAME};
    set $auth_user "";
    set $auth_email "";
    set $auth_groups "";
    # Probes may use plain HTTP; everything else goes to HTTPS.
    location = /healthz {
        include /etc/nginx/conf.d/proxy-to-app.inc;
    }
    location / {
        return 301 https://${PUBLIC_HOSTNAME}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${PUBLIC_HOSTNAME};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 2m;
    # The session cookie and the groups grow with a user's groups (Entra ID:
    # a 36-character ID each); nginx's 4-8 KB defaults would refuse them.
    large_client_header_buffers 4 32k;
    # The app compresses its answers (COMPRESS_RESPONSES); passed through as they are.
    gzip off;

    # Nobody signed in until oauth2-proxy says so.
    set $auth_user "";
    set $auth_email "";
    set $auth_groups "";
    set $auth_cookie "";

    # oauth2-proxy: the login pages and the callback.
    location /oauth2/ {
        proxy_pass http://oauth2-proxy:4180;
        proxy_buffer_size 32k;
        proxy_buffers 4 32k;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
    }

    # Sign out (#546): oauth2-proxy deletes its session cookie and sends the
    # browser to "/" (not back here, as $request_uri would); nginx turns that
    # into the identity provider's logout when there is one.
    location = /oauth2/sign_out {
        proxy_pass http://oauth2-proxy:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Auth-Request-Redirect /;
        proxy_redirect ~^/$ $sign_out_next;
    }

    # Asked before every request below: 202 signed in, 401 not.
    location = /oauth2/auth {
        internal;
        if ($api_token) {
            return 202;
        }
        proxy_pass http://oauth2-proxy:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
        proxy_buffer_size 32k;
        proxy_buffers 4 32k;
    }

    location @login {
        return 302 /oauth2/start?rd=https://${PUBLIC_HOSTNAME}$request_uri;
    }

    # Asked on the status API (#527): staff signed in get their identity, so a
    # tenant's name on Availability opens its page without a key; anyone else
    # goes on as anonymous (202 without identity, never the login), and the
    # app asks for a status token.
    location = /oauth2/auth-optional {
        internal;
        if ($api_token) {
            return 202;
        }
        proxy_pass http://oauth2-proxy:4180/oauth2/auth;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
        proxy_buffer_size 32k;
        proxy_buffers 4 32k;
        proxy_intercept_errors on;
        error_page 401 403 = @anonymous;
    }
    location @anonymous {
        return 202;
    }

    # No login (the app checks access itself), and no identity passed on.
    location = /healthz {
        include /etc/nginx/conf.d/proxy-to-app.inc;
    }
    # After Sign out without OIDC_LOGOUT_URL (#546): no login here, or the
    # identity provider would sign the user straight back in.  Fixed text,
    # no data; its own CSP for its own styles.
    location = /signed-out {
        default_type text/html;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        return 200 '<!DOCTYPE html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Signed out</title><style>body{font:16px/1.5 system-ui,sans-serif;max-width:32rem;margin:15vh auto;padding:0 1rem;color:#1f2937;background:#fff}a{color:#2563eb}.button{display:inline-block;padding:.5rem 1rem;border-radius:.375rem;background:#2563eb;color:#fff;text-decoration:none}p.note{color:#6b7280;font-size:14px}@media (prefers-color-scheme:dark){body{color:#e5e7eb;background:#0f172a}a{color:#60a5fa}.button{background:#3b82f6;color:#fff}p.note{color:#9ca3af}}</style><h1>You are signed out</h1><p><a class="button" href="/">Sign in again</a></p><p class="note">You are still signed in at your company sign-in, so signing in again won’t ask for a password. To end that too, sign out at <a href="${OIDC_ISSUER_URL}">${OIDC_ISSUER_URL}</a>.</p></html>';
    }

    # The tenant status page: customers have no company login; their status
    # token is checked by the app (#291).  Its files: the Nuxt build's
    # /_nuxt/ (#463), the app's code only, no data.
    location /status/ {
        include /etc/nginx/conf.d/proxy-to-app.inc;
    }
    # Its data: a status token, or staff signed in (#527), never the login.
    location /api/status/ {
        auth_request /oauth2/auth-optional;
        auth_request_set $auth_user $upstream_http_x_auth_request_preferred_username;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;
        auth_request_set $auth_groups $upstream_http_x_auth_request_groups;
        include /etc/nginx/conf.d/proxy-to-app.inc;
    }
    location /_nuxt/ {
        include /etc/nginx/conf.d/proxy-to-app.inc;
    }
    # Prometheus scrapes the app directly, inside the network.
    location = /metrics {
        return 404;
    }

    # Everything else: signed in, or an API token.
    location / {
        auth_request /oauth2/auth;
        auth_request_set $auth_user $upstream_http_x_auth_request_preferred_username;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;
        auth_request_set $auth_groups $upstream_http_x_auth_request_groups;
        # A refreshed session cookie goes back to the browser.
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie;
        # A location's add_header replaces the server's: HSTS again.
        add_header Strict-Transport-Security "max-age=31536000" always;
        error_page 401 = @login;
        include /etc/nginx/conf.d/proxy-to-app.inc;
    }
}
