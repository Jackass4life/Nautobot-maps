# Copy to .env (never commit it).
POSTGRES_PASSWORD=change-me
# Where browsers reach the two services (also the API's allowed CORS origin).
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
API_PORT=8000
WEB_PORT=3000

# Sign-in (#582): disabled (development only) or header (behind oauth2-proxy).
AUTH_MODE=disabled
# header mode: addresses of the sign-in proxy and the web container (CSV of CIDRs).
AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128
AUTH_PROXY_SECRET=
# Identity headers the proxy sets; AUTH_FORWARD_HEADERS (web) must name the same two.
AUTH_HEADER_USER=X-Forwarded-User
AUTH_HEADER_GROUPS=X-Forwarded-Groups
AUTH_FORWARD_HEADERS=x-forwarded-user,x-forwarded-groups
AUTH_VIEWER_GROUPS=
AUTH_OPERATOR_GROUPS=
AUTH_ADMIN_GROUPS=
AUTH_DEFAULT_ROLE=
AUTH_REQUIRE_VIEWER=false
