# Copy to .env (never commit it).
POSTGRES_PASSWORD=change-me
# Where browsers reach the app: its pages and its API (#594).
API_PORT=8000

# Sign-in (#582, #592): disabled (development only) or header (behind oauth2-proxy).
AUTH_MODE=disabled
# header mode: the sign-in proxy's address (CSV of CIDRs).
AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128
AUTH_PROXY_SECRET=
AUTH_HEADER_USER=X-Forwarded-User
AUTH_HEADER_GROUPS=X-Forwarded-Groups
AUTH_VIEWER_GROUPS=
AUTH_OPERATOR_GROUPS=
AUTH_ADMIN_GROUPS=
AUTH_DEFAULT_ROLE=
AUTH_REQUIRE_VIEWER=false
# Every other setting: docs/configuration.md (the same names as the current app).
