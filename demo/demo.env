# The demo stack's settings (demo/docker-compose.yml, #739): every container reads
# this file. Demo values only: nothing here is a real secret.
POSTGRES_DB=nautobot_maps
POSTGRES_USER=nautobot_maps
POSTGRES_PASSWORD=nautobot_maps
NAUTOBOT_MAPS_DATABASE_URL=postgresql://nautobot_maps:nautobot_maps@postgres:5432/nautobot_maps
NAUTOBOT_URL=http://mock-nautobot:8080
NAUTOBOT_TOKEN=demo-token
CACHE_TTL=60
SITE_TIER_FIELD=tier
DEVICE_CRITICALITY_FIELD=criticality
TIER_DEVICE_LEVEL=gold:critical,silver:medium
# The pages pass the API's paths on to it.
API_URL=http://api:5000
# MOCK_SCALE=1200 adds 1,200 generated sites (demo/README.md).
MOCK_SCALE=0
